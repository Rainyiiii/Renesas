[name]
model_name=custom

[train-configure]
epochs=100
steps=70,90
batch_size=16
subdivisions=1
learning_rate=0.001

[model-configure]
pre_weights=None
classes=1
width=352
height=352
anchor_num=3
anchors=12.64,19.39, 37.88,51.48, 55.71,138.31, 126.91,78.23, 131.57,214.55, 279.92,258.87

[data-configure]
train=./datasets/custom/train.txt
val=./datasets/custom/val.txt
names=./data/custom.names

[name]
model_name=ho-ra8p1-192

[train-configure]
epochs=40
steps=20,32
batch_size=16
subdivisions=1
learning_rate=0.0005

[model-configure]
pre_weights=./weights/ho-best.pth
classes=4
width=192
height=192
anchor_num=3
anchors=20.53,31.49, 32.09,39.43, 37.46,21.01, 42.19,68.39, 56.39,28.33, 61.69,74.24

[data-configure]
train=./datasets/ho_ra8p1_192/train.txt
val=./datasets/ho_ra8p1_192/val.txt
names=./data/ho.names

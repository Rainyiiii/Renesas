[name]
model_name=my-first-project-v3-ra8p1-192

[train-configure]
epochs=101
steps=60,85
batch_size=16
subdivisions=1
learning_rate=0.0002

[model-configure]
pre_weights=./weights/my-first-project-v2-best.pth
classes=4
width=192
height=192
anchor_num=3
anchors=25.68,114.04, 36.65,52.11, 64.35,73.77, 69.86,99.53, 73.38,37.07, 92.77,113.99

[data-configure]
train=./datasets/my_first_project_v3_192/train.txt
val=./datasets/my_first_project_v3_192/val.txt
names=./data/ho.names
